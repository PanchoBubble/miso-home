[Unit]
Description=Miso local assistant runtime
After=network.target miso-audio-playback.service
Wants=miso-audio-playback.service

[Service]
Type=simple
User=miso
Group=miso
SupplementaryGroups=audio gpio
WorkingDirectory=/opt/miso/app
Environment=PYTHONPATH=/opt/miso/app/src
Environment=PYTHONDONTWRITEBYTECODE=1
# MISO_HOST must stay loopback or the LAN address, never 0.0.0.0: cloudflared
# routes a public hostname to localhost:80, so a wildcard bind would publish
# the dashboard through the tunnel.
Environment=MISO_HOST=127.0.0.1
Environment=MISO_PORT=80
Environment=MISO_DB_PATH=/var/lib/miso/db/miso.sqlite3
Environment=MISO_STATE_DIR=/var/lib/miso/state
Environment=MISO_MODEL_DIR=/var/lib/miso/models
Environment=MISO_DEVELOPER_ROOT=/opt/miso/app
EnvironmentFile=-/etc/miso/miso-audio.env
EnvironmentFile=-/etc/miso/miso-stt.env
EnvironmentFile=-/etc/miso/miso-tts.env
EnvironmentFile=-/etc/miso/miso-wake.env
EnvironmentFile=-/etc/miso/miso-buttons.env
EnvironmentFile=-/etc/miso/miso-conversation.env
EnvironmentFile=-/etc/miso/miso-calendar.env
EnvironmentFile=-/etc/miso/miso-display.env
EnvironmentFile=-/etc/miso/miso.env
ExecStartPre=/usr/bin/python3 -m miso --check-config
ExecStart=/usr/bin/python3 -m miso
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
RuntimeDirectory=miso
RuntimeDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-alsa rw
# The BMO talk and stop buttons. gpiozero reaches the header through a
# character device; the exact node differs between Pi 4 and Pi 5, so both
# the chip class and the memory-mapped nodes are allowed.
DeviceAllow=char-gpiochip rw
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/gpiomem0 rw
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/miso /run/miso /run/miso-display
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
