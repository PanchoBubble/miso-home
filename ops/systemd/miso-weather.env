# The location only seeds the household setting. Once anyone sets a place from
# the dashboard or by voice it lives in the database and wins from then on.
MISO_WEATHER_DEFAULT_LOCATION=
MISO_WEATHER_UNITS=metric
MISO_WEATHER_LANGUAGE=en
# Seconds between polls of the household location. 0 disables polling, which
# also blanks the weather panel on the companion face.
MISO_WEATHER_POLL_SECONDS=900
