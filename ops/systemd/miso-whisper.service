[Unit]
Description=Miso resident whisper.cpp transcription server
After=network.target
Before=miso.service

[Service]
Type=simple
User=miso
Group=miso
# --host stays loopback. cloudflared publishes a public hostname to this box,
# so anything bound wider would put the household's microphone audio on the
# open internet. --port matches MISO_STT_SERVER_URL in miso-stt.env.
#
# --threads 4 is the whole Pi. The service is idle between utterances, and the
# benchmark that chose ggml-tiny was measured at four threads.
#
# Carrying decoder context between requests would let one utterance bleed into
# the next, which the CLI lane never risked because it exited between them.
# whisper.cpp v1.9.1 already defaults no_context to true in the server and
# exposes no flag for it, so there is nothing to pass here. A later release
# adds -nc/--no-context; if this unit is ever moved forward, check the default
# still holds. --convert is deliberately absent: Miso posts real 16 kHz WAV,
# and enabling it would pull ffmpeg into this service for nothing.
#
# --suppress-nst is the one decoding flag that differs from the benchmarked
# CLI invocation. It keeps "[BLANK_AUDIO]" and friends out of the transcript,
# where they would otherwise arrive as a request. Re-measure word error rate
# against docs/miso-transcription-benchmark.md before treating this lane's
# accuracy as equal to the CLI's.
#
# The prompt is the same bilingual command prompt the CLI lane uses; whisper
# conditions on it as if it preceded the utterance. See
# docs/miso-transcription-benchmark.md.
ExecStart=/usr/local/bin/whisper-server \
  --model /var/lib/miso/models/whisper/ggml-tiny.bin \
  --host 127.0.0.1 \
  --port 8910 \
  --threads 4 \
  --language auto \
  --no-gpu \
  --suppress-nst \
  --prompt "Miso. Comandos de casa en español e inglés. Pon un temporizador de ocho minutos. ¿Cuánto tiempo queda en el temporizador? Añade leche a la lista de la compra. Enciende la luz de la cocina. Set a timer for twenty seconds. Add bread to the shopping list."
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
RuntimeDirectory=miso-whisper
RuntimeDirectoryMode=0750
WorkingDirectory=/run/miso-whisper
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/miso-whisper
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Loopback only: the server talks to nothing but the Miso runtime on this box.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
