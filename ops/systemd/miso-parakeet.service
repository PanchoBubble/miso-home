[Unit]
Description=Miso resident Parakeet transcription worker
After=network.target
Before=miso.service

[Service]
Type=simple
User=miso
Group=miso
# Loopback only. cloudflared publishes a public hostname to this box, so a
# recogniser bound wider would put household audio on the open internet. The
# worker refuses a non-loopback --host itself as well.
ExecStart=/opt/miso/parakeet/bin/python /opt/miso/app/src/miso/parakeet_worker.py \
  --model-dir /var/lib/miso/models/parakeet \
  --host 127.0.0.1 \
  --port 8911 \
  --threads 4
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
RuntimeDirectory=miso-parakeet
RuntimeDirectoryMode=0750
WorkingDirectory=/run/miso-parakeet
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
# ONNX Runtime otherwise spawns a thread per core on top of --threads and the
# two pools fight over the same four cores.
Environment=OMP_NUM_THREADS=4

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/miso-parakeet
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
