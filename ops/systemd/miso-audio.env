MISO_AUDIO_PLAYBACK_BACKEND=pulse
# The MAX98357A I2S amplifier, as PipeWire names it. The installer overwrites
# this file on every deploy, so the sink that is actually wired to the box has
# to live here, not only in /etc. The JBL Clip 3 was
# bluez_output.F8_5C_7D_19_EE_9E.1; set it back if the speaker returns.
MISO_AUDIO_PLAYBACK_CARD=alsa_output.platform-soc_107c000000_sound.stereo-fallback
MISO_AUDIO_PLAYBACK_PROXY=/run/miso-audio/playback.sock
