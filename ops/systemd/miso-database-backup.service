[Unit]
Description=Atomic encrypted backup of Miso local state
RequiresMountsFor=/media/pancho/T7
After=miso.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/miso/miso-backup.env
ExecStart=/usr/local/sbin/miso-backup backup
ExecStartPost=/usr/local/sbin/miso-backup verify --quick
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/media/pancho/T7/backups/miso /var/lib/miso /run/lock
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
