MISO_STT_ENABLED=true

# Transcription lanes, fastest first. Each falls through to the next when it
# fails, and a failed lane sits out MISO_STT_LANE_COOLDOWN_SECONDS rather than
# being retried on the next sentence: once the uplink is gone, paying the
# hosted timeout on every utterance is slower than having no hosted lane.

# 1. Hosted OpenAI-compatible lane. Audio leaves the house on this lane. The
# key is read from MISO_STT_CLOUD_API_KEY, falling back to the LLM lane's
# MISO_OPENAI_API_KEY so one credential covers both. Set it in
# /etc/miso/miso.env, which is root-owned: never here, never in git. Unset
# means Miso stays fully offline.
# MISO_STT_CLOUD_API_KEY=
MISO_STT_CLOUD_BASE_URL=https://api.openai.com/v1
# whisper-1 answers verbose_json and names the language, which is what keeps a
# Spanish question from being answered in English. The 4o transcribe models are
# faster but answer json only, so their language is guessed from the words.
# Point base URL at https://api.groq.com/openai/v1 with
# whisper-large-v3-turbo to switch provider without touching code.
MISO_STT_CLOUD_MODEL=whisper-1
MISO_STT_CLOUD_RESPONSE_FORMAT=verbose_json
MISO_STT_CLOUD_TIMEOUT_SECONDS=6

# 2. Wispr Flow. Approval-gated by Wispr, so usually unset. Audio leaves the
# house on this lane too.
# MISO_STT_WISPR_API_KEY=
MISO_STT_WISPR_TIMEOUT_SECONDS=4

# 3. Resident local whisper.cpp, started by miso-whisper.service. The model is
# loaded once at boot instead of once per utterance. Measured on the Pi that is
# only marginally faster than the CLI: model load is 131 ms, and the real cost
# is the encoder. Blank disables the lane.
MISO_STT_SERVER_URL=http://127.0.0.1:8910
MISO_STT_SERVER_TIMEOUT_SECONDS=15

MISO_STT_LANE_COOLDOWN_SECONDS=30

# 4. Last resort. Reloads ggml-tiny from disk for every single utterance.
MISO_STT_EXECUTABLE=/usr/local/bin/whisper-cli
MISO_STT_MODEL=/var/lib/miso/models/whisper/ggml-tiny.bin
MISO_STT_THREADS=4
MISO_STT_TIMEOUT_SECONDS=45

# Only transcribe while the conversation is expecting speech. Ungated, the
# recogniser ran on every sound in the house, burned a core on the neighbours'
# television, and handed the state machine whatever the room happened to say.
# Turning this off also disables the wake-phrase-by-transcription fallback,
# which needs the recogniser running while Miso is idle.
MISO_STT_GATED=true

MISO_STT_VAD_THRESHOLD_DBFS=-38
MISO_STT_VAD_MINIMUM_SPEECH_MILLISECONDS=250
# Every millisecond here is paid on every single sentence, before the
# recogniser has even started. 400 ms is short enough to feel immediate and
# long enough to survive the pause in "set a timer for... five minutes".
MISO_STT_VAD_END_SILENCE_MILLISECONDS=400
MISO_STT_VAD_MAXIMUM_UTTERANCE_MILLISECONDS=15000
MISO_STT_VAD_PRE_ROLL_MILLISECONDS=200
