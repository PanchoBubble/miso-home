MISO_CONVERSATION_ENABLED=true
MISO_CONVERSATION_LISTEN_TIMEOUT_SECONDS=8
MISO_CONVERSATION_CHECKBACK_TIMEOUT_SECONDS=5
MISO_CONVERSATION_ACKNOWLEDGEMENT=Yes?
# Open the microphone on the wake phrase instead of speaking "Yes?" first, so
# "Miso, set a timer for five minutes" can be said in one breath.
MISO_CONVERSATION_ACKNOWLEDGE_WAKE=false
# Playback on this box lags what the state machine thinks it finished saying,
# and the speaker sits beside the microphone with no echo cancellation, so the
# microphone stays closed for this long after Miso stops speaking.
MISO_CONVERSATION_ECHO_GUARD_SECONDS=2.0

# After an answer the microphone closes. It stays open only when Miso asked a
# question, and then only long enough to hear the reply. A turn that ran a tool
# closes immediately whatever it said: the instruction is complete.
MISO_CONVERSATION_FOLLOW_UP_TIMEOUT_SECONDS=4
# One wake buys one bounded session. Every listening window is clamped to this,
# so background speech that keeps re-arming the timer can no longer hold the
# microphone open indefinitely.
MISO_CONVERSATION_SESSION_TIMEOUT_SECONDS=45
# Consecutive transcripts Miso heard but could not act on (a foreign language,
# its own echo, the wake phrase alone) before it gives up and closes.
MISO_CONVERSATION_MAXIMUM_DISCARDS=3
# A safety net: a capture whose transcript never arrives used to hold the
# microphone open with no deadline at all.
MISO_CONVERSATION_TRANSCRIBE_TIMEOUT_SECONDS=20
